<?xml version="1.0"?>
<robot name="cabinet">
  <link name="base"/>
  <joint name="cabinet_joint" type="fixed">
    <parent link="base"/>
    <child link="cabinet"/>
    <origin xyz="0 0 0"/>
  </joint>
  <link name="cabinet">
    <collision>
      <geometry><box size="0.6 0.6 1.0"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.6 0.6 1.0"/></geometry>
    </visual>
  </link>
  <joint name="drawer_joint" type="prismatic">
    <parent link="cabinet"/>
    <child link="drawer"/>
    <origin xyz="0 0 0.3"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.4" effort="10" velocity="1"/>
  </joint>
  <link name="drawer">
    <collision>
      <geometry><box size="0.5 0.5 0.2"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.5 0.5 0.2"/></geometry>
    </visual>
  </link>
  <joint name="handle_joint" type="fixed">
    <parent link="drawer"/>
    <child link="handle"/>
    <origin xyz="0 0.26 0"/>
  </joint>
  <link name="handle">
    <collision>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </collision>
    <visual>
      <geometry><box size="0.12 0.03 0.03"/></geometry>
    </visual>
  </link>
</robot>
