<?xml version="1.0"?>
<!--
  Two links whose declarations differ only in whether they carry a collision element, so a
  parser reading them can be told apart by what it does with the one that has none.
-->
<robot name="visual_without_collision">
  <link name="visual_only">
    <visual>
      <origin xyz="0.1 0.2 0.3" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.5 0.6"/>
      </geometry>
    </visual>
  </link>
  <link name="visual_and_collision">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.5 0.6"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 0.8 0.9"/>
      </geometry>
    </collision>
  </link>
  <joint name="visual_only_to_visual_and_collision" type="fixed">
    <parent link="visual_only"/>
    <child link="visual_and_collision"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
  </joint>
</robot>
