@dataclass(eq=False)
class {{ name }}{% if bases %}({{ bases | join(", ") }}){% endif %}:
{% if fields %}
{% for f in fields %}
    {{ f.name }}: {{ f.type_hint }}{% if f.default is not none %} = {{ f.default }}{% endif %}

{% endfor %}
{% endif %}
{% for stub in stubs %}
    def {{ stub }}(self, *arguments, **keywords):
        """
        Refuse to answer {{ stub }}, which no run composing {{ name }} could know.
        """
        raise ComposedClassCannotAct(class_name="{{ name }}", method="{{ stub }}")

{% endfor %}
{% if not fields and not stubs %}
    pass
{% endif %}
