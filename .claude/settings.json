{
  "env": {
    "PYTEST_ADDOPTS": "-qq --no-header",
    "TQDM_DISABLE": "1",
    "NO_COLOR": "1",
    "UV_NO_PROGRESS": "1"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check_rules.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
